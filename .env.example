# ============================================================
# Variables de entorno del BACKEND (FastAPI)
# Copia este archivo como `.env` en la raÃ­z del proyecto.
# NO subas el archivo `.env` real al repositorio.
# ============================================================

ENVIRONMENT=development
SECRET_KEY=reemplazar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# --- Base de datos ---
# Por defecto se usa SQLite (no requiere instalar nada).
SQLITE_PATH=backend/inventario.db

# Para usar MySQL define la cadena completa (tiene prioridad):
# DATABASE_URL_OVERRIDE="mysql+pymysql://usuario:clave@127.0.0.1:3306/inventario?charset=utf8mb4"
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=inventario
# MYSQL_USER=inventario
# MYSQL_PASSWORD=cambiar-esta-clave

# --- API / archivos ---
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIRECTORY=backend/uploads
PUBLIC_UPLOAD_URL=/uploads
MAX_UPLOAD_MB=10

# --- Seguridad del login ---
LOGIN_ACCOUNT_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=30
LOGIN_ATTEMPT_WINDOW_SECONDS=300
TRUST_FORWARDED_FOR=false

# --- Cuenta inicial ---
# Se crea automÃ¡ticamente la primera vez que arranca el backend.
# Cambia la contraseÃ±a despuÃ©s del primer ingreso.
INITIAL_ADMIN_NAME=Administrador del sistema
INITIAL_ADMIN_EMAIL=admin@inventario.com
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin12345

